<div class="home-intro">


    <!-- Introduction 分割线 -->

    <div class="intro-title">

        <span class="intro-icon">
            <i class="fa fa-user"></i>
        </span>

        <span>
            introduction
        </span>

    </div>



    <div class="intro-card">

        <h2>
            <%= theme.homeIntro.title %>
        </h2>


        <p>
            <%- theme.homeIntro.content.replace(/\n/g,'<br>') %>
        </p>


        <p class="motto">
            <%= theme.homeIntro.motto %>
        </p>

    </div>


</div>